# =============================================================================
# azure-infra/terraform.tfvars
# 이 파일을 복사하여 terraform.tfvars 로 저장 후 값을 수정하세요.
#   cp terraform.tfvars.example terraform.tfvars
# =============================================================================

# ── 필수 설정 ─────────────────────────────────────────────────────────────────

# 리소스 그룹 이름
# - tofu destroy 시 Harbor/Nexus VM + 네트워크 + 디스크 전체 일괄 삭제
# - 환경/목적에 따라 변경 (예: rg-infra-dev, rg-infra-staging)
resource_group_name = "rg-infra-registry"

# Harbor admin 비밀번호 (영문 대소문자 + 숫자 + 특수문자 권장)
harbor_admin_password = "Harbor@Admin2024!"

# ── 선택 설정 (기본값으로도 동작) ──────────────────────────────────────────────

# Azure 리전 (기본: KoreaCentral)
# location = "KoreaCentral"

# SSH 접근 허용 CIDR (보안 강화 시 본인 공인 IP로 제한)
# curl https://checkip.amazonaws.com 으로 본인 IP 확인 후 /32 로 설정
# allowed_ssh_cidr = "0.0.0.0/0"  # 개발 환경 기본값 (전체 허용)
# allowed_ssh_cidr = "1.2.3.4/32" # 권장: 본인 IP 제한

# VM 크기 (비용 절감 시 더 작은 크기로 변경)
# harbor_vm_size = "Standard_B2s"   # 2 vCPU / 4GB (~$35/월)
# nexus_vm_size  = "Standard_B2ms"  # 2 vCPU / 8GB (~$60/월)

# 디스크 크기 (GB)
# harbor_disk_size_gb = 80
# nexus_disk_size_gb  = 100

# Harbor 버전
# harbor_version = "v2.12.1"

# ── 추가 포트 개방 (선택) ───────────────────────────────────────────────────────
# priority 범위: 200~499 (기존 고정 룰 100~130과 충돌 방지)
# port:   단일 포트("443") 또는 범위("9000-9001")
# source: "*" (전체 허용) 또는 특정 CIDR ("1.2.3.4/32")
#
# 예시 1: Harbor HTTPS + Prometheus exporter 포트 추가
# extra_open_ports = [
#   { name = "allow-harbor-https", priority = 200, port = "443" },
#   { name = "allow-prometheus-exporter", priority = 210, port = "9090", source = "10.0.0.0/8" },
# ]
#
# 예시 2: 특정 관리자 IP에만 추가 포트 허용
# extra_open_ports = [
#   { name = "allow-custom-app", priority = 200, port = "8443", source = "1.2.3.4/32" },
# ]
#
# 기본값: [] (추가 포트 없음)
# extra_open_ports = []
